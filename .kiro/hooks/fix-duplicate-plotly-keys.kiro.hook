{
  "enabled": true,
  "name": "Fix Duplicate Plotly Chart Keys",
  "description": "When app.py is saved, checks for any st.plotly_chart() calls missing a unique key argument and prompts the agent to add them to prevent StreamlitDuplicateElementId errors.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "CODE/app.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check CODE/app.py for any st.plotly_chart() calls that are missing a unique `key` argument. For each one found, add a unique key like key=\"chart_<descriptive_name>\" to prevent the StreamlitDuplicateElementId error. Make sure every plotly_chart call in the file has a distinct key."
  }
}